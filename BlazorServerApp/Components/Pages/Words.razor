@page "/words"
@using BlazorServerApp.Data.DTOs
@using BlazorServerApp.Models.Wordle
@using BlazorServerApp.Services.Wordle
@inject WordListService WordListService

<PageTitle>Wörter - Wordle Pro</PageTitle>

<div class="words-container">
    <header class="words-header">
        <div>
            <h2 class="words-title">Wortliste</h2>
            <p class="words-subtitle">
                Das Spiel zieht sein Lösungswort zufällig aus dieser Liste.
            </p>
        </div>
        <div class="words-count">
            <span class="words-count-value">@_words.Count</span>
            <span class="words-count-label">Wörter</span>
        </div>
    </header>

    <section class="words-panel">
        <h3 class="words-section-title">Eigene Liste importieren</h3>
        <p class="words-hint">
            Ein Wort pro Zeile &mdash; Kommas, Semikolons und Leerzeichen funktionieren
            ebenfalls als Trennzeichen. Zeilen, die mit <code>#</code> beginnen, werden
            ignoriert. Jedes Wort muss genau @WordleRules.WordLength Buchstaben von
            A&ndash;Z haben. Wörter mit Umlauten werden abgelehnt, da die
            Bildschirmtastatur keine Umlaut-Tasten hat.
        </p>

        <div class="words-upload">
            <label class="words-file-label">
                <span class="material-symbols-outlined">upload_file</span>
                <span>@(_fileName ?? ".txt-Datei auswählen")</span>
                <InputFile OnChange="HandleFileSelected" accept=".txt" class="words-file-input"/>
            </label>
        </div>

        <textarea class="words-textarea"
                  rows="10"
                  placeholder="@("APFEL\nBLUME\nKATZE")"
                  @bind="_wordListText"
                  @bind:event="oninput"></textarea>

        <div class="words-mode">
            <label class="words-radio">
                <input type="radio"
                       name="import-mode"
                       checked="@(!_replaceExisting)"
                       @onchange="@(() => _replaceExisting = false)"/>
                <span>Zur bestehenden Liste hinzufügen</span>
            </label>
            <label class="words-radio">
                <input type="radio"
                       name="import-mode"
                       checked="@_replaceExisting"
                       @onchange="@(() => _replaceExisting = true)"/>
                <span>Bestehende Liste ersetzen</span>
            </label>
        </div>

        <div class="words-actions">
            <button class="words-btn words-btn-primary"
                    disabled="@(!CanImport)"
                    @onclick="HandleImportClicked">
                @(_isImporting ? "Wird importiert..." : "Importieren")
            </button>
            <button class="words-btn words-btn-ghost"
                    disabled="@_isImporting"
                    @onclick="ClearInput">
                Leeren
            </button>
        </div>

        @if (_errorMessage is not null)
        {
            <div class="words-result words-result-error">
                <span class="material-symbols-outlined">error</span>
                <span>@_errorMessage</span>
            </div>
        }
        else if (_importResult is not null)
        {
            <div class="words-result words-result-success">
                <span class="material-symbols-outlined">check_circle</span>
                <div>
                    <p class="words-result-main">@BuildResultMessage(_importResult)</p>
                    @if (_importResult.Duplicates > 0 || _importResult.Rejected > 0)
                    {
                        <p class="words-result-detail">
                            @if (_importResult.Duplicates > 0)
                            {
                                <span>@_importResult.Duplicates als Duplikate übersprungen. </span>
                            }
                            @if (_importResult.Rejected > 0)
                            {
                                <span>
                                    @_importResult.Rejected als ungültig abgelehnt
                                    (z.B. @string.Join(", ", _importResult.RejectedSamples)).
                                </span>
                            }
                        </p>
                    }
                </div>
            </div>
        }
    </section>

    <section class="words-panel">
        <h3 class="words-section-title">Aktuelle Liste</h3>

        @if (_words.Count == 0)
        {
            <p class="words-hint">
                Die Liste ist leer &mdash; das Spiel verwendet ein festes Ersatzwort,
                bis du etwas importierst.
            </p>
        }
        else
        {
            <div class="words-grid">
                @foreach (var word in _words)
                {
                    <span class="words-chip">@word</span>
                }
            </div>
        }
    </section>
</div>

@code {
    /// <summary>
    /// Obergrenze fuer den Datei-Upload. Die Datei wird komplett in den
    /// Speicher gelesen, deshalb ueberhaupt eine Grenze; 1 MB ist weit mehr,
    /// als eine Wortliste je braucht.
    /// </summary>
    private const long MaxUploadKilobytes = 1024;

    private const long MaxUploadBytes = MaxUploadKilobytes * 1024;

    private List<string> _words = [];

    private string _wordListText = string.Empty;
    private string? _fileName;
    private bool _replaceExisting;
    private bool _isImporting;

    private WordImportResultDto? _importResult;
    private string? _errorMessage;

    /// <summary>Der Knopf bleibt gesperrt, solange nichts zu importieren ist.</summary>
    private bool CanImport =>
        !_isImporting && !string.IsNullOrWhiteSpace(_wordListText);

    /// <summary>
    /// Setzt die Rueckmeldung nach einem Import zusammen. Als Methode statt als
    /// Kette von Ternaeren im Markup, damit die Faelle einzeln lesbar bleiben.
    /// </summary>
    private static string BuildResultMessage(WordImportResultDto result)
    {
        var wordOrWords = result.Added == 1 ? "Wort" : "Wörter";
        var actionText = result.Replaced ? "importiert (Liste ersetzt)" : "hinzugefügt";

        return $"{result.Added} {wordOrWords} {actionText} — insgesamt {result.TotalAfterImport}.";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadWordsAsync();
    }

    private async Task LoadWordsAsync()
    {
        _words = await WordListService.GetAllAsync();
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        _importResult = null;
        _errorMessage = null;

        var file = e.File;

        if (file.Size > MaxUploadBytes)
        {
            _errorMessage = $"Die Datei ist zu gross (maximal {MaxUploadKilobytes} KB).";
            _fileName = null;
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(MaxUploadBytes);
            using var reader = new StreamReader(stream);

            _wordListText = await reader.ReadToEndAsync();
            _fileName = file.Name;
        }
        catch (IOException ex)
        {
            _errorMessage = $"Die Datei konnte nicht gelesen werden: {ex.Message}";
            _fileName = null;
        }
    }

    private async Task HandleImportClicked()
    {
        _isImporting = true;
        _importResult = null;
        _errorMessage = null;

        try
        {
            _importResult = await WordListService.ImportAsync(_wordListText, _replaceExisting);
            await LoadWordsAsync();

            _wordListText = string.Empty;
            _fileName = null;
        }
        finally
        {
            _isImporting = false;
        }
    }

    private void ClearInput()
    {
        _wordListText = string.Empty;
        _fileName = null;
        _importResult = null;
        _errorMessage = null;
    }
}
