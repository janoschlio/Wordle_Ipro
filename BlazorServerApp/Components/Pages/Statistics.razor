@page "/statistics"
@using BlazorServerApp.Services.Statistics
@using BlazorServerApp.Data.DTOs
@using BlazorServerApp.Components.Statistics
@using BlazorServerApp.Services.Player
@inject StatisticsService StatisticsService
@inject PlayerService PlayerService
@rendermode InteractiveServer

<PageTitle>Statistik - Wordle Pro</PageTitle>

<div class="stats-container">
    @if (_statistics == null)
    {
        <div class="stats-loading">
            <p>Statistik wird geladen...</p>
        </div>
    }
    else
    {
        <header class="stats-header">
            <h2 class="stats-title">Deine Leistung</h2>
            <div class="stats-badge">
                <span class="badge-text">Persönliche Übersicht</span>
                <div class="badge-dot"></div>
            </div>
        </header>

        <div class="stats-cards">
            <div class="stat-card">
                <p class="stat-label">Gespielte Runden</p>
                <div class="stat-value-group">
                    <span class="stat-value">@_statistics.GamesPlayed</span>
                </div>
            </div>

            <div class="stat-card">
                <p class="stat-label">Effizienz (Ø Versuche)</p>
                <div class="stat-value-group">
                    <span class="stat-value">@_statistics.AverageGuesses.ToString("F1")</span>
                </div>
            </div>

            <div class="stat-card">
                <p class="stat-label">Aktuelle Serie</p>
                <div class="stat-value-group">
                    <span class="stat-value">@_statistics.CurrentStreak</span>
                </div>
            </div>

            <div class="stat-card">
                <p class="stat-label">Längste Serie</p>
                <div class="stat-value-group">
                    <span class="stat-value">@_statistics.MaxStreak</span>
                    <span class="stat-subtext">Tage</span>
                </div>
            </div>
        </div>

        <section class="distribution-section">
            <div class="section-header">
                <div>
                    <h3 class="section-title">Verteilung der Versuche</h3>
                    <p class="section-subtitle">Häufigkeit der Siege nach Anzahl benötigter Versuche</p>
                </div>
            </div>

            <div class="distribution-chart">
                <GuessDistributionChart Distribution="_statistics.GuessDistribution"/>
            </div>
        </section>

        <div class="bottom-sections">
            <div class="recent-section">
                <h4 class="small-section-title">Letzte Runden</h4>
                <div class="recent-badges">
                    @foreach (var result in _statistics.RecentResults.Take(7))
                    {
                        <div class="result-badge @(result.IsWon ? "result-win" : "result-loss")">
                            @(result.IsWon ? "S" : "N")
                        </div>
                    }
                </div>
                <p class="recent-summary">
                    @{
                        var recentWins = _statistics.RecentResults.Take(7).Count(r => r.IsWon);
                        var recentGames = _statistics.RecentResults.Take(7).Count();
                    }
                    @recentWins Siege in den letzten @recentGames Runden
                </p>
            </div>
        </div>
    }
</div>

@code {
    private StatisticsDto? _statistics;

    // Die Spieler-Kennung liegt im localStorage und ist deshalb erst nach dem
    // ersten Rendern lesbar -- waehrend des Prerenderings gibt es kein JS.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var playerId = await PlayerService.EnsurePlayerIdAsync();
        _statistics = await StatisticsService.GetStatisticsAsync(playerId);

        StateHasChanged();
    }

}