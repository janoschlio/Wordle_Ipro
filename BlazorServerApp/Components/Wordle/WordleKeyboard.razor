@using BlazorServerApp.Models.Wordle

<div class="kb-row">
    @foreach (var key in KeysInRow(0))
    {
        <WordleKey KeyModel="key" OnPressed="OnKeyPressed" />
    }
</div>

<div class="kb-row">
    <div class="kb-spacer"></div>
    @foreach (var key in KeysInRow(1))
    {
        <WordleKey KeyModel="key" OnPressed="OnKeyPressed" />
    }
    <div class="kb-spacer"></div>
</div>

<div class="kb-row">
    @foreach (var key in KeysInRow(2))
    {
        <WordleKey KeyModel="key" OnPressed="OnKeyPressed" />
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<KeyModel> Keys { get; set; } = Array.Empty<KeyModel>();
    [Parameter] public EventCallback<string> OnKeyPressed { get; set; }

    private IEnumerable<KeyModel> KeysInRow(int row) => Keys.Where(k => k.Row == row);
}
