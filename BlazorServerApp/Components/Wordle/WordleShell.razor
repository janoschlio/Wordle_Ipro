@using BlazorServerApp.Components.Shared
@using BlazorServerApp.Models.Wordle
@using BlazorServerApp.Services.Wordle
@implements IDisposable

@* tabindex="0" macht das div fokussierbar. Nur so empfaengt es @onkeydown und
   die physische Tastatur funktioniert -- das ist der Zweck dieses Wrappers. *@
<div tabindex="0"
     class="key-capture"
     @ref="_keyCapture"
     @onkeydown="HandlePhysicalKeyDown">
    <header class="wordle-header">
        <div class="header-inner">
            <h1 class="wordle-title">WORDLE</h1>
            <GameRulesPopover AriaLabel="Spielanleitung">
                <h3>Spielanleitung</h3>
                <ul>
                    <li>Errate das versteckte <b>Wort aus 5 Buchstaben</b> in <b>6 Versuchen</b>.</li>
                    <li>Jeder Versuch muss ein <b>gültiges Wort aus 5 Buchstaben</b> sein.</li>
                    <li>Drücke <b>Enter</b>, um deinen Versuch abzuschicken.</li>
                    <li>Mit <b>Backspace</b> löschst du einen Buchstaben.</li>
                </ul>

                <h3>Farben der Kacheln</h3>
                <ul>
                    <li><span class="dot correct"></span> <b>Grün</b>: richtiger Buchstabe an der richtigen Stelle.</li>
                    <li><span class="dot present"></span> <b>Gelb</b>: richtiger Buchstabe an der falschen Stelle.</li>
                    <li><span class="dot absent"></span> <b>Grau</b>: Buchstabe kommt im Wort nicht vor.</li>
                </ul>

                <h3>Mehrfache Buchstaben</h3>
                <p>Kommt ein Buchstabe mehrfach vor, richtet sich die Färbung danach, wie oft er im
                    gesuchten Wort tatsächlich enthalten ist.</p>
            </GameRulesPopover>
        </div>
    </header>

    <div class="board-wrap">
        <WordleBoard Tiles="Tiles"/>

        <p class="guess-hint @HintCssClass" role="status" aria-live="polite">
            @HintText
        </p>
    </div>

    <div class="keyboard">
        <WordleKeyboard Keys="Keys" OnKeyPressed="HandleVirtualKeyPressed"/>
    </div>

    <WordleLegend/>

    <ResultModal IsOpen="IsGameWon" TargetWord="@TargetWord" OnAction="ResetGame"
                 Variant="ResultVariant.Win" Icon="stars"
                 Title="Ausgezeichnet!" Subtitle="Du hast das Wort gefunden"
                 ButtonText="NOCHMAL SPIELEN" />

    <ResultModal IsOpen="IsGameLost" TargetWord="@TargetWord" OnAction="ResetGame"
                 Variant="ResultVariant.Lose" Icon="sentiment_dissatisfied"
                 Title="Guter Versuch!" Subtitle="Das Wort war:"
                 ButtonText="NEUER VERSUCH" />
</div>

@code {
    [Inject] private WordleGameService GameService { get; set; } = default!;

    private ElementReference _keyCapture;

    /// <summary>
    /// Nach dem Schliessen eines Modals liegt der Fokus auf dessen Knopf, der
    /// dann aus dem DOM verschwindet. Ohne erneutes Fokussieren waere die
    /// physische Tastatur danach wirkungslos.
    /// </summary>
    private bool _shouldFocus;

    private TileModel[][] Tiles => GameService.Tiles;
    private IReadOnlyList<KeyModel> Keys => GameService.Keys;
    private string TargetWord => GameService.TargetWord;
    private bool IsGameWon => GameService.IsGameWon;
    private bool IsGameLost => GameService.IsGameLost;
    private bool IsGuessInvalid => GameService.IsGuessInvalid;

    private string HintText =>
        IsGuessInvalid ? "Dieses Wort steht nicht in der Wortliste." : "";

    private string HintCssClass =>
        IsGuessInvalid ? "guess-hint-visible" : "";

    protected override async Task OnInitializedAsync()
    {
        GameService.OnStateChanged += StateHasChanged;
        await ResetGame();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || _shouldFocus)
        {
            _shouldFocus = false;
            await _keyCapture.FocusAsync();
        }
    }

    private async Task ResetGame()
    {
        await GameService.ResetGameAsync();
        _shouldFocus = true;
    }

    private async Task HandleVirtualKeyPressed(string key)
    {
        // Die Bildschirmtaste ist mit "Back" beschriftet, die physische Taste
        // meldet sich als "Backspace". Beide Wege sollen dasselbe Vokabular
        // benutzen, deshalb wird hier uebersetzt.
        var normalizedKey = key == "Back" ? "Backspace" : key;

        await ApplyKey(normalizedKey);
    }

    private async Task HandlePhysicalKeyDown(KeyboardEventArgs e)
    {
        await ApplyKey(e.Key);
    }

    /// <summary>Beide Eingabewege laufen hier zusammen.</summary>
    private async Task ApplyKey(string key)
    {
        if (key == "Enter")
            await GameService.SubmitGuessAsync();
        else if (key == "Backspace")
            GameService.Backspace();
        else if (key.Length == 1 && char.IsLetter(key[0]))
        {
            // char.IsLetter laesst auch Umlaute durch. Die stehen in keiner
            // Wortliste, der Versuch wird also spaeter ohnehin abgelehnt.
            GameService.AddLetter(char.ToUpperInvariant(key[0]));
        }
    }

    public void Dispose()
    {
        GameService.OnStateChanged -= StateHasChanged;
    }
}

