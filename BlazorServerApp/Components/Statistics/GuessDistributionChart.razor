@using BlazorServerApp.Models.Wordle

<div class="distribution-chart">
    @{
        var highestCount = HighestCount();
    }

    @* Bewusst ueber 1..MaxAttempts statt ueber das Dictionary: so erscheinen auch
       leere Balken, und die Reihenfolge stimmt. Ein Dictionary garantiert keine. *@
    @foreach (var attempts in Enumerable.Range(1, WordleRules.MaxAttempts))
    {
        var count = Distribution.GetValueOrDefault(attempts);
        var barHeightPercent = BarHeightPercent(count, highestCount);

        <div class="chart-column">
            <div class="bar-container">
                <div class="bar @(count > 0 ? "has-data" : "")" style="height: @barHeightPercent%;">
                    <div class="bar-fill">@count</div>
                </div>
            </div>
            <div class="guess-label">@attempts</div>
        </div>
    }
</div>

@code {
    /// <summary>Anzahl Siege je benoetigter Versuchszahl.</summary>
    [Parameter] public Dictionary<int, int> Distribution { get; set; } = new();

    /// <summary>
    /// Der hoechste Balkenwert; er entspricht 100 Prozent Hoehe.
    /// DefaultIfEmpty faengt den Fall ab, dass noch keine Runde gespielt wurde --
    /// Max() wuerde auf einer leeren Sammlung eine Ausnahme werfen.
    /// </summary>
    private int HighestCount()
    {
        return Distribution.Values.DefaultIfEmpty(0).Max();
    }

    private double BarHeightPercent(int count, int highestCount)
    {
        if (highestCount == 0)
        {
            return 0;
        }

        return (double)count / highestCount * 100;
    }
}
